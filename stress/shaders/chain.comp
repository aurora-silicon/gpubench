#version 450
// Chained data: v[base + i] = v[base + i] * 3 + k + i. Each link of a chain depends on the
// previous one, so a lost, reordered or early-started link changes the final value.
layout(local_size_x = 64) in;
layout(set = 0, binding = 0, std430) buffer D { uint v[]; };
layout(push_constant) uniform PC { uint base; uint n; uint k; } pc;
void main()
{
   uint i = gl_GlobalInvocationID.x;
   if (i >= pc.n)
      return;
   v[pc.base + i] = v[pc.base + i] * 3u + pc.k + i;
}
