#version 460
// Ray-query traversal: one closest-hit opaque ray along +z per invocation. Writes the hit
// instance's custom index, the primitive index and t, so the CPU can check every ray.
#extension GL_EXT_ray_query : require
layout(local_size_x = 64) in;
layout(set = 0, binding = 0) uniform accelerationStructureEXT tlas;
layout(set = 0, binding = 1, std430) readonly buffer R { vec4 ray[]; };
layout(set = 0, binding = 2, std430) writeonly buffer O { uvec4 o[]; };
layout(push_constant) uniform PC { uint n; } pc;
void main()
{
   uint i = gl_GlobalInvocationID.x;
   if (i >= pc.n)
      return;
   vec4 r = ray[i];
   rayQueryEXT q;
   rayQueryInitializeEXT(q, tlas, gl_RayFlagsOpaqueEXT, 0xFFu, r.xyz, 0.0, vec3(0.0, 0.0, 1.0), r.w);
   while (rayQueryProceedEXT(q)) {
   }
   if (rayQueryGetIntersectionTypeEXT(q, true) != gl_RayQueryCommittedIntersectionNoneEXT)
      o[i] = uvec4(uint(rayQueryGetIntersectionInstanceCustomIndexEXT(q, true)),
                   uint(rayQueryGetIntersectionPrimitiveIndexEXT(q, true)),
                   floatBitsToUint(rayQueryGetIntersectionTEXT(q, true)), 1u);
   else
      o[i] = uvec4(0u, 0u, 0u, 0u);
}
