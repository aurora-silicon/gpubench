# Generates shaders.c: every SPIR-V module as a uint32_t array plus its size.
# Inputs: SPV_FILES (list of .spv), OUT.
set(body "/* generated by suite/shaders/embed.cmake */\n#include <stddef.h>\n#include <stdint.h>\n")
foreach(f IN LISTS SPV_FILES)
  get_filename_component(n "${f}" NAME_WE)
  get_filename_component(e "${f}" EXT)
  string(REPLACE ".spv" "" e "${e}")
  string(REPLACE "." "" e "${e}")
  set(var "${n}_${e}")
  file(READ "${f}" hex HEX)
  string(LENGTH "${hex}" hl)
  math(EXPR words "${hl} / 8")
  set(arr "")
  set(i 0)
  while(i LESS hl)
    string(SUBSTRING "${hex}" ${i} 8 w)
    string(SUBSTRING "${w}" 0 2 b0)
    string(SUBSTRING "${w}" 2 2 b1)
    string(SUBSTRING "${w}" 4 2 b2)
    string(SUBSTRING "${w}" 6 2 b3)
    string(APPEND arr "0x${b3}${b2}${b1}${b0},")
    math(EXPR i "${i} + 8")
  endwhile()
  string(APPEND body "const uint32_t ${var}[] = {${arr}};\nconst size_t ${var}_size = sizeof(${var});\n")
endforeach()
file(WRITE "${OUT}" "${body}")
