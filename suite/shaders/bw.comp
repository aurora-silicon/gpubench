#version 450
// compute.heavy kind=bw: stream copy, one vec4 per thread.
layout(local_size_x = 256) in;
layout(set = 0, binding = 0) readonly buffer Src { vec4 s[]; };
layout(set = 0, binding = 1) writeonly buffer Dst { vec4 d[]; };
void main()
{
   uint i = gl_GlobalInvocationID.x;
   d[i] = s[i];
}
