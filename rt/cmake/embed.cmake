# cmake -DOUT=<file.c> -DMODE=spv|text -DSYMBOL=<name> -DINPUTS="name1=path1;name2=path2" -P embed.cmake
# spv:  emits one byte array per input and the table vk_find_spv() searches.
# text: emits `const char SYMBOL[]` from the single input (NUL-terminated).
set(src "/* generated by rt/cmake/embed.cmake, do not edit */\n#include <stddef.h>\n#include <stdint.h>\n#include <string.h>\n")
set(table "")
set(i 0)
foreach(pair IN LISTS INPUTS)
  string(FIND "${pair}" "=" eq)
  string(SUBSTRING "${pair}" 0 ${eq} name)
  math(EXPR p1 "${eq} + 1")
  string(SUBSTRING "${pair}" ${p1} -1 path)
  file(READ "${path}" hex HEX)
  if(MODE STREQUAL "text")
    set(hex "${hex}00")
  endif()
  string(LENGTH "${hex}" hl)
  math(EXPR nbytes "${hl} / 2")
  string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
  string(REGEX REPLACE "(0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,)" "\\1\n" bytes "${bytes}")
  if(MODE STREQUAL "text")
    string(APPEND src "const char ${SYMBOL}[] = {\n${bytes}};\n")
  else()
    string(APPEND src "_Alignas(16) static const unsigned char spv${i}[] = {\n${bytes}};\n")
    string(APPEND table "   {\"${name}\", (const uint32_t *)spv${i}, ${nbytes}},\n")
  endif()
  math(EXPR i "${i} + 1")
endforeach()
if(MODE STREQUAL "spv")
  string(APPEND src "typedef struct { const char *name; const uint32_t *code; size_t size; } vk_spv;\n")
  string(APPEND src "static const vk_spv table[] = {\n${table}   {NULL, NULL, 0}};\n")
  string(APPEND src "const vk_spv *vk_find_spv(const char *name)\n{\n   for (const vk_spv *s = table; s->name; s++)\n      if (!strcmp(s->name, name)) return s;\n   return NULL;\n}\n")
endif()
file(WRITE "${OUT}.tmp" "${src}")
file(RENAME "${OUT}.tmp" "${OUT}")
