#version 460
// Composite: direct sun light (shadowed by the RT pass) + ambient, blended with the reflection by
// the surface reflectivity, sky for background, Reinhard tone map and gamma. A = 1 on reflective
// pixels (used to measure the reflective pixel fraction). MSL twin: composite in rt.metal.
#extension GL_GOOGLE_include_directive : require
#include "common.glsl"

layout(local_size_x = 8, local_size_y = 8) in;
layout(set = 0, binding = 0) uniform Frame { FRAME_UBO_BODY } fr;
layout(set = 0, binding = 1) uniform sampler2D g_albedo;
layout(set = 0, binding = 2) uniform sampler2D g_normal;
layout(set = 0, binding = 3) uniform sampler2D g_depth;
layout(set = 0, binding = 4) uniform sampler2D g_rt;
layout(set = 0, binding = 5, rgba8) uniform writeonly image2D o_color;

void main()
{
   uvec2 px = gl_GlobalInvocationID.xy;
   uint W = fr.ip.x, H = fr.ip.y;
   if (px.x >= W || px.y >= H) return;
   float depth = texelFetch(g_depth, ivec2(px), 0).r;
   vec3 sun = fr.sun_dir.xyz;
   vec3 c;
   float refl = 0.0;
   if (depth == 0.0) {
      vec2 ndc = (vec2(px) + 0.5) / vec2(float(W), float(H)) * 2.0 - 1.0;
      vec4 wp = fr.inv_view_proj * vec4(ndc, 0.5, 1.0);
      c = sky(normalize(wp.xyz / wp.w - fr.cam_pos.xyz), sun);
   } else {
      vec4 ar = texelFetch(g_albedo, ivec2(px), 0);
      vec4 nr = texelFetch(g_normal, ivec2(px), 0);
      vec4 rt = texelFetch(g_rt, ivec2(px), 0);
      vec3 N = normalize(nr.xyz);
      refl = nr.w;
      vec3 direct = ar.rgb * (fr.params.z + fr.sun_dir.w * max(dot(N, sun), 0.0) * rt.a);
      c = direct * (1.0 - refl) + rt.rgb * refl;
   }
   c = c / (1.0 + c);
   c = pow(c, vec3(1.0 / 2.2));
   imageStore(o_color, ivec2(px), vec4(c, refl > 0.0 ? 1.0 : 0.0));
}
