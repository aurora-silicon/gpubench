#version 460
// Debug stub of rtreflect.comp for devices without ray queries (RTB_NO_RT=1): no rays, no
// reflection, unshadowed. Lets the raster, composite and image path be checked anywhere.
layout(local_size_x = 8, local_size_y = 8) in;
layout(set = 0, binding = 9, rgba16f) uniform writeonly image2D o_rt;
void main()
{
   imageStore(o_rt, ivec2(gl_GlobalInvocationID.xy), vec4(0.0, 0.0, 0.0, 1.0));
}
