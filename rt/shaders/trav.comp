#version 460
// rt.trav: one closest-hit opaque ray query per invocation against synthetic geometry
// (common/trav.h). Parallel rays along +z from z = -1 on a grid. Writes the hit distance (or -1) so
// nothing is optimised away. MSL twin: trav in rt.metal.
#extension GL_EXT_ray_query : require

layout(local_size_x = 64) in;
layout(set = 0, binding = 0) uniform accelerationStructureEXT tlas;
layout(std430, set = 0, binding = 1) writeonly buffer OUT { float result[]; };
layout(push_constant) uniform PC {
   float x0, y0, dx, dy;
   uint width, nrays;
   float tmax;
   uint pad;
} pc;

void main()
{
   uint id = gl_GlobalInvocationID.x;
   if (id >= pc.nrays) return;
   vec3 o = vec3(pc.x0 + (float(id % pc.width) + 0.5) * pc.dx, pc.y0 + (float(id / pc.width) + 0.5) * pc.dy, -1.0);
   rayQueryEXT rq;
   rayQueryInitializeEXT(rq, tlas, gl_RayFlagsOpaqueEXT, 0xFFu, o, 0.0, vec3(0.0, 0.0, 1.0), pc.tmax);
   while (rayQueryProceedEXT(rq)) {
   }
   float t = -1.0;
   if (rayQueryGetIntersectionTypeEXT(rq, true) != gl_RayQueryCommittedIntersectionNoneEXT)
      t = rayQueryGetIntersectionTEXT(rq, true);
   result[id] = t;
}
