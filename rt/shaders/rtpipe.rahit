#version 460
// Alpha test of the non-opaque sails (any-hit), for primary and shadow rays alike.
#extension GL_EXT_ray_tracing : require
#extension GL_GOOGLE_include_directive : require
#include "common.glsl"
#include "rtres.glsl"

hitAttributeEXT vec2 bary_;

void main()
{
   if (!candidate_opaque(uint(gl_InstanceID), uint(gl_PrimitiveID), bary_)) ignoreIntersectionEXT;
}
